      projTriggerStyle: 'display:flex;align-items:center;gap:10px;width:100%;padding:12px 14px;border-radius:11px;cursor:pointer;background:#fff;transition:.14s;border:1px solid ' + (S.projOpen ? '#6148F9' : 'rgba(20,20,30,0.14)'),
