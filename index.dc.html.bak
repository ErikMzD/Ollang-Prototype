                : 'border:1px solid rgba(20,20,30,0.12);background:#fff;color:#16161A;cursor:pointer'),
      })),
      dtHasSidebarActions: dtActions.filter(a => !a.header).length > 0,
      dtHeaderActions: dtActions.filter(a => a.header).map(a => ({
