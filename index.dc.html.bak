      billLotsContextLabel: billLotUrgent ? 'Expiring soon' : 'Nearest lot',
      billLotsChevronStyle: this.billChevronStyle(!!S.billLotsExpanded),
      billOnViewUsage: () => set({ billingView: 'invoice-detail', billingInvoiceId: bd.invoices[0].id, billInvoiceTab: 'usage' }),
      // ---- Credits & Plan metric cards (Billing home) ----
      billCardShellStyle,
      billCardPlanTileStyle: billCardPlanTile.tileStyle, billCardPlanTileIcon: billCardPlanTile.icon,
      billCardCreditsTileStyle: billCardCreditsTile.tileStyle, billCardCreditsTileIcon: billCardCreditsTile.icon,
      billCardCycleTileStyle: billCardCycleTile.tileStyle, billCardCycleTileIcon: billCardCycleTile.icon,
      billCardPlanLabel: BL.planName + ' plan',
      billCardPlanPriceLine, billCardPlanShowUnit: !billIsCustom,
      billCardPlanAllowanceCaption: this.formatCredits(BL.planAllowance) + '/month',
      billCardCreditsCaption, billCardCreditsCaptionColor: billLotUrgent ? '#E0135B' : '#8A8A96',
      billCardCreditsDangerPct: billLotUrgent ? billCardLotPct : 0,
      billCardCreditsAccentPct: billLotUrgent ? (100 - billCardLotPct) : billCardLotPct,
      // The important, plan-specific action lives inside the Plan card (violet, primary) — the header CTA
      // above is always plain "Manage Plan", the same for every account.
      billCardPlanCtaLabel: billIsCustom ? 'Contact sales' : 'Upgrade your plan',
      billCardPlanCtaOnClick: billIsCustom ? billOnContactSales : (() => set({ billingView: 'change-plan' })),
      billCardPlanCtaShowIcon: !billIsCustom,
      billCardCreditsCtaLabel: billIsCustom ? 'See credit rates' : 'Buy credits',
      billCardCreditsCtaOnClick: billIsCustom ? billOnJumpToRates : billOnBuyOpen,
      billCardCycleLine1: this.formatCreditsNumber(bd.cycleConsumed) + ' of',
      billCardCycleLine2: this.formatCredits(BL.planAllowance),
      billRingPctLabel: Math.round(billRingPct) + '%', billRingDasharray, billRingC: billRingC.toFixed(2),
      billCardCyclePctNumber: String(Math.round(billRingPct)),
      billCardCycleBarPct: billRingPct,
      billCardCycleBarColor: billRingPct >= 90 ? '#E5484D' : '#6148F9',
      billCardPlanSegments: (() => {
        const n = 60;
        const tierRank = this.PLAN_TIERS.findIndex(t => t.name === BL.planName);
        const pct = billIsCustom ? 100 : Math.round(((tierRank + 1) / this.PLAN_TIERS.length) * 100);
        const filled = Math.round((pct / 100) * n);
        return Array.from({ length: n }, (_, i) => ({ bg: i < filled ? '#6148F9' : '#F1F1F4' }));
      })(),
      billCardCreditsSegments: (() => {
        const n = 60;
        const dangerPct = billLotUrgent ? billCardLotPct : 0;
        const accentPct = billLotUrgent ? (100 - billCardLotPct) : billCardLotPct;
        const dangerCount = Math.round((dangerPct / 100) * n);
        const accentCount = Math.round((accentPct / 100) * n);
        return Array.from({ length: n }, (_, i) => ({ bg: i < dangerCount ? '#E5484D' : i < dangerCount + accentCount ? '#6148F9' : '#F1F1F4' }));
      })(),
      billCardCycleSegments: (() => {
        const n = 60;
        const filled = Math.round((billRingPct / 100) * n);
        // Purple\u2192orange gradient across filled segments only, matching the ring's danger-red override.
        const stops = ['#A855F7', '#B24FE0', '#C2489B', '#D14487', '#DB4172', '#E23F63', '#E75A50', '#EA6B47', '#ED7B41', '#F0893D', '#F3993A', '#F6A937'];
        const danger = billRingPct >= 90;
        return Array.from({ length: n }, (_, i) => ({
          bg: i < filled ? (danger ? '#E5484D' : stops[Math.min(stops.length - 1, Math.round((i / Math.max(1, filled - 1)) * (stops.length - 1)))]) : '#F1F1F4',
        }));
      })(),
      billLotsExpanded: !!S.billLotsExpanded,
      billOnToggleLots: () => set({ billLotsExpanded: !S.billLotsExpanded }),
      billLotsToggleLabel: S.billLotsExpanded ? 'Hide all lots' : 'Show all ' + bd.lots.length + ' lots',
      billShowLotsToggle: bd.lots.length > 1,

      billPlanCards, billCycleToggle,
      billFeaturesExpanded, billOnToggleFeatures, billFeatureToggleLabel,
      planCheckIcon: this.icon('check', '#fff', 11),
      billOnBuyOpen,
      billingCustomPlanName: BL.planName, billNextBillingDate: BL.nextBillingDate,
      billCustomPlanFeatureLine,
      billOnContactSales,
      billOnManageSubscription: billOnManagePlan,
      billOnJumpToRates, billOnJumpToRatesFromChangePlan,
      rightArrowIcon: React.createElement('svg', { width: 14, height: 14, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 2, strokeLinecap: 'round', strokeLinejoin: 'round' }, React.createElement('path', { d: 'M5 12h14M13 5l7 7-7 7' })),

      billHasOverdue: !!billOverdueInvoice,
      billOverdueBadgeStyle: billOverdueBadge ? billOverdueBadge.pillStyle : '',
      billOverdueDotStyle: billOverdueBadge ? billOverdueBadge.dotStyle : '',
      billOverdueId: billOverdueInvoice ? billOverdueInvoice.id : '',
      billOverdueAmount: billOverdueInvoice ? this.money(billOverdueInvoice.amount) : '',
      billOverdueDue: billOverdueInvoice ? billOverdueInvoice.due : '',
      billShowPayNow: cap.canPayInvoice,
      billOnPayOverdue: billOverdueInvoice ? (() => set({ billingView: 'invoice-detail', billingInvoiceId: billOverdueInvoice.id })) : (() => {}),

      // C3: every settings row carries its control on the right, matching Workspace Settings' pattern —
      // these are configuration, not a readout. No-op handlers: the ticket asks for the controls to exist
      // in this pass, not for each to open a fully built flow.
      billCardValue: bd.defaultCard || 'No card on file',
      billSpendLimitExpanded, billSpendLimitCalm: billShowSpendLimit && !bd.spendLimitReached,
      billLimitBadgeStyle: billLimitBadge.pillStyle, billLimitDotStyle: billLimitBadge.dotStyle,
      billLimitAmountLabel: billShowSpendLimit && bd.spendLimitSet ? this.money(bd.spendLimitAmount) : '',
      billLimitResetsLabel: billShowSpendLimit ? bd.spendLimitResets : '',
      billLimitCalmValue: billShowSpendLimit ? (bd.spendLimitSet ? (this.money(bd.spendLimitAmount) + ' \u00B7 resets ' + bd.spendLimitResets) : 'No limit set') : '',
      billOnChangeLimit: billOnChangeLimitClick,

      // ---- Payment Method, pass 3 ----
      billCanManagePayment,
      billLimitEditing, billLimitIsSet, billLimitIsNone,
      billLimitDraftValue: S.billLimitDraft || '',
      billOnLimitDraftChange: e => set({ billLimitDraft: e.target.value }),
      billOnChangeLimitClick, billOnLimitCancel, billOnLimitSave, billOnLimitRemove,
      billLimitSaveStyle: this.renderButton('primary', 'sm', { disabled: !billLimitDraftValid }),
      billLimitSaveDisabled: !billLimitDraftValid,
      billLimitMeterTrackStyle: billLimitMeter.trackStyle, billLimitMeterFillStyle: billLimitMeter.fillStyle,
      billLimitSpentLabel: this.money(billLimitSpent),
      billLimitAmountBoldLabel: this.money(bd.spendLimitAmount || 0),

      billNotifShowEmpty, billNotifEmptyRowStyle, billNotifPills,
      billNotifAdding, billNotifInputRowStyle,
      billNotifDraftValue: S.billNotifDraft || '',
      billOnNotifDraftChange: e => set({ billNotifDraft: e.target.value }),
      billOnNotifAddClick, billOnNotifCancel, billOnNotifConfirm,
      billNotifAddBtnStyle: this.renderButton('primary', 'sm', { disabled: !billNotifDraftValid }),
      billNotifConfirmDisabled: !billNotifDraftValid,
      billNotifShowAddCta, billNotifAddBtnRowStyle,
      trashIcon: this.icon('trash', '#8A8A96', 15),

      billHomeCurrentInvoiceRow, billHomeCurrentInvoiceShown: !!billHomeCurrentInvoiceRow, billHomeRecentInvoiceRows,
      billAllInvoiceRows: billAllInvoices, billInvoiceCount: bd.invoices.length, billInvoiceGridStyle,
      billInvoicePage, billInvoicePages,
      billInvoiceRangeLabel: (billInvoiceRangeStart + ' - ' + billInvoiceRangeEnd),
      billInvoicePageSize,
      billInvoicePageSizeOpen: !!S.billInvoicePageSizeOpen,
      billOnInvoicePageSizeToggle: () => set({ billInvoicePageSizeOpen: !S.billInvoicePageSizeOpen }),
      billInvoicePageSizeBtnStyle: 'display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:9px;cursor:pointer;font:500 13px var(--font-ui);border:1px solid ' + (S.billInvoicePageSizeOpen ? '#6148F9' : 'rgba(0,0,29,0.12)') + ';background:#fff;color:#16161A',
      billInvoicePageSizeOptsMenu: [10, 20, 50].map(sz => ({
        label: String(sz), onClick: () => set({ billInvoicePageSize: sz, billInvoicePage: 1, billInvoicePageSizeOpen: false }),
        style: 'padding:8px 9px;border-radius:7px;cursor:pointer;font:500 13px var(--font-ui);color:#16161A;' + (billInvoicePageSize === sz ? 'background:rgba(97,72,249,0.07)' : ''),
      })),
      billInvoiceSortDir: billInvSortDir,
      billOnInvoiceSortToggle: () => set({ billInvoiceSortDir: billInvSortDir === 'asc' ? 'desc' : 'asc' }),
      billInvoiceSortArrow: billInvSortDir === 'asc' ? '\u2191' : '\u2193',
      billInvoicePrevDisabled: billInvoicePage <= 1, billInvoiceNextDisabled: billInvoicePage >= billInvoicePages,
      billOnInvoicePrev: () => set({ billInvoicePage: Math.max(1, billInvoicePage - 1) }),
      billOnInvoiceNext: () => set({ billInvoicePage: Math.min(billInvoicePages, billInvoicePage + 1) }),
      billCurrentInvoiceId: billCurrentInvoice.id, billCurrentInvoiceBadgeStyle: billCurrentBadge.pillStyle,
      billCurrentInvoiceDotStyle: billCurrentBadge.dotStyle, billCurrentInvoiceStatusLabel: billCurrentBadge.label,
      billCurrentInvoiceDateLine: (billCurrentInvoice.status === 'overdue' ? 'Was due ' : billCurrentInvoice.status === 'paid' ? 'Paid ' : 'Due ') + billCurrentInvoice.due,
      // Invoice detail header: one slot, content swapped by active tab. Status Filter/Download only ever
      // acted on Transactions' line items, so they (and the invoice-id-as-title treatment) don't belong on
      // Current usage — that tab leads with what it's actually for, folding the invoice/cycle reference
      // into the subtitle instead.
      billInvHeaderIconTileStyle: (S.billInvoiceTab === 'usage') ? billUsageHeaderIconTile.tileStyle : billInvoiceIconTile.tileStyle,
      billInvHeaderIconTileIcon: (S.billInvoiceTab === 'usage') ? billUsageHeaderIconTile.icon : billInvoiceIconTile.icon,
      billInvHeaderTitle: (S.billInvoiceTab === 'usage') ? 'Current usage' : billCurrentInvoice.id,
      billInvHeaderSubtitle: (S.billInvoiceTab === 'usage')
        ? (billCurrentInvoice.id + ' \u00B7 this cycle \u00B7 renews ' + BL.nextBillingDate)
        : (billCurrentInvoice.status === 'overdue' ? 'Was due ' : billCurrentInvoice.status === 'paid' ? 'Paid ' : 'Due ') + billCurrentInvoice.due,
      billInvHeaderShowBadge: S.billInvoiceTab !== 'usage',
      billInvHeaderShowActions: S.billInvoiceTab !== 'usage',
      billCurrentInvoicePayable: billCurrentPayable,
      billOnPayCurrent: () => billOnOpenPay(billCurrentInvoice.id),
      billInvoiceIconTileStyle: billInvoiceIconTile.tileStyle, billInvoiceIconTileIcon: billInvoiceIconTile.icon,
      billLineHeadStyle,

      // ---- Invoice detail: line items, status filter, download, pagination, pay modal (pass 2) ----
      billLineStatusOpts, billLineStatusFilter,
      billLineStatusLabel: (billLineStatusOpts.find(o => o.id === billLineStatusFilter) || billLineStatusOpts[0]).label,
      billLineStatusFilterOpen: !!S.billLineStatusFilterOpen,
      billOnLineStatusFilterToggle: () => set({ billLineStatusFilterOpen: !S.billLineStatusFilterOpen }),
      billLineStatusBtnStyle: 'display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:9px;cursor:pointer;font:500 13px var(--font-ui);border:1px solid ' + (S.billLineStatusFilterOpen ? '#6148F9' : 'rgba(0,0,29,0.12)') + ';background:#fff;color:#16161A',
      billLineStatusOptsMenu: billLineStatusOpts.map(o => ({
        label: o.label, onClick: () => set({ billLineStatusFilter: o.id, billLinePage: 1, billLineStatusFilterOpen: false }),
        style: 'padding:8px 9px;border-radius:7px;cursor:pointer;font:500 13px var(--font-ui);color:#16161A;' + (billLineStatusFilter === o.id ? 'background:rgba(97,72,249,0.07)' : ''),
      })),
      billDownloadOpen: !!S.billDownloadOpen,
      billOnToggleDownload: () => set({ billDownloadOpen: !S.billDownloadOpen }),
      billOnDownload: () => set({ billDownloadOpen: false }),
      billInvoiceTabs: [
        { id: 'transactions', label: 'Transactions' },
        { id: 'usage', label: 'Current usage' },
      ].map(t => ({
        label: t.label, onClick: () => set({ billInvoiceTab: t.id }),
        style: 'padding:11px 15px;border:none;background:transparent;cursor:pointer;font:600 13.5px var(--font-ui);transition:.14s;color:'
          + ((S.billInvoiceTab || 'transactions') === t.id ? '#4F39D8' : '#8A8A96')
          + ';box-shadow:' + ((S.billInvoiceTab || 'transactions') === t.id ? 'inset 0 -2px 0 #6148F9' : 'none'),
      })),
      billInvoiceTabIsTransactions: (S.billInvoiceTab || 'transactions') === 'transactions',
      billInvoiceTabIsUsage: S.billInvoiceTab === 'usage',
      billLineRows: billLineItemsPage,
      billLineNetTotalLabel: this.money(billLineTotal),
      billLineRangeLabel: billLineRangeStart + ' - ' + billLineRangeEnd,
      billLineCount: billLineItemsFiltered.length, billLineEmpty: billLineItemsFiltered.length === 0,
      billLinePageSize,
      billLinePageSizeOpen: !!S.billLinePageSizeOpen,
      billOnLinePageSizeToggle: () => set({ billLinePageSizeOpen: !S.billLinePageSizeOpen }),
      billLinePageSizeBtnStyle: 'display:inline-flex;align-items:center;gap:7px;height:32px;padding:0 12px;border-radius:9px;cursor:pointer;font:500 13px var(--font-ui);border:1px solid ' + (S.billLinePageSizeOpen ? '#6148F9' : 'rgba(0,0,29,0.12)') + ';background:#fff;color:#16161A',
      billLinePageSizeOptsMenu: [10, 25, 50, 100].map(sz => ({
        label: String(sz), onClick: () => set({ billLinePageSize: sz, billLinePage: 1, billLinePageSizeOpen: false }),
        style: 'padding:8px 9px;border-radius:7px;cursor:pointer;font:500 13px var(--font-ui);color:#16161A;' + (billLinePageSize === sz ? 'background:rgba(97,72,249,0.07)' : ''),
      })),
      billLinePrevDisabled: billLinePage <= 1, billLineNextDisabled: billLinePage >= billLinePages,
      billOnLinePrev: () => set({ billLinePage: Math.max(1, billLinePage - 1) }),
      billOnLineNext: () => set({ billLinePage: Math.min(billLinePages, billLinePage + 1) }),

      billPayOpen: !!billPayInvoice, billPayInvoiceId: billPayInvoiceId || '',
      billPayMethods: billPayMethods.map(m => ({
        id: m.id, label: m.label, mark: m.mark, markStyle: m.markStyle,
        rowStyle: 'display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:10px;border:1.5px solid ' + (billPayMethod === m.id ? '#6148F9' : 'rgba(0,0,29,0.1)') + ';cursor:pointer;background:' + (billPayMethod === m.id ? 'rgba(97,72,249,0.05)' : '#fff'),
        onClick: () => set({ billPayMethod: m.id }),
      })),
      billOnClosePay, billOnPaySubmit,
      billPayProcessing: !!S.billPayProcessing,
      billPayNowLabel: S.billPayProcessing ? 'Processing\u2026' : 'Pay Now',
      billToastKindStyle: S.billToastKind === 'success' ? 'background:#0F7B4F' : S.billToastKind === 'error' ? 'background:#C42B31' : 'background:#16161A',

      billUsageCycleLine: 'This cycle \u00B7 renews ' + BL.nextBillingDate,
      billHierarchy, billAiTotalLabel, billHitlRows, billLotRows, billLotGridStyle,
      billUsageSyncedLabel, billUsageRefreshing: !!S.billUsageRefreshing,
      billOnRefreshUsage,
      billOnGoHome: () => set({ billingView: 'home' }),
      // \u00a76: Ollang Credits / HITL Credits tabs \u2014 HITL tab only renders when this account/state has rows.
      billShowHitlTab, billUsageTabIsOllang: billUsageTab === 'ollang', billUsageTabIsHitl: billUsageTab === 'hitl',
      billOnUsageTabOllang: () => set({ billUsageTab: 'ollang' }), billOnUsageTabHitl: () => set({ billUsageTab: 'hitl' }),
      billUsageTabOllangStyle: billUsageTabBtnStyle(billUsageTab === 'ollang'), billUsageTabHitlStyle: billUsageTabBtnStyle(billUsageTab === 'hitl'),

      // ---- \u00a77 Credit rates ----
      billCreditRatesExpanded: !!S.billCreditRatesExpanded, billOnToggleCreditRates,
      billCreditRatesChevronStyle: 'display:inline-block;transition:.15s;color:#8A8A96;' + (S.billCreditRatesExpanded ? 'transform:rotate(180deg)' : ''),
      billRateServiceCols: this.CREDIT_RATE_SERVICES,
      billRateGridStyle: 'display:grid;grid-template-columns:170px repeat(7,112px);gap:0;min-width:954px',
      billRateFilterValue, billOnRateFilterChange: e => set({ billRateFilter: e.target.value }),
      billRateModelRows, billRateModelsEmpty: billRateModelRows.length === 0,
      billPricingAccordions,
      billHumanEditClusterCols, billHumanEditRows,
      billHumanEditGridStyle: 'display:grid;grid-template-columns:180px repeat(' + this.HUMAN_EDIT_CLUSTERS.length + ',1fr);gap:0;min-width:640px',
      billNoticeStyle,

      billBuyCardTileStyle: billBuyTile.tileStyle, billBuyCardTileIcon: billBuyTile.icon,
      billBuyPackageCards: billBuyPackageCards.map(p => ({
        amountLabel: this.formatCreditsNumber(p.amount),
        priceLabel: this.money(p.amount * 0.002),
        btnLabel: (S.billBuyProcessing && S.billBuyAmount === p.amount) ? 'Processing\u2026' : 'Purchase',
        disabled: S.billBuyProcessing,
        onClick: p.onClick,
      })),
      billToastShown: !!S.billToast, billToastMessage: S.billToast || '',

      billingWidgetPlan: BL.planName, billingWidgetCredits: this.formatCredits(bd.balance), billingWidgetOverdue: !!billOverdueInvoice,
      billingWidgetTileStyle: billWidgetTile.tileStyle, billingWidgetTileIcon: billWidgetTile.icon,
      billInvoicedByContractTileStyle: this.renderIconTile('card', 34, '#F1F1F4', '#6B6B78').tileStyle,
      billInvoicedByContractTileIcon: this.renderIconTile('card', 34, '#F1F1F4', '#6B6B78').icon,
      // Only shown when this profile can actually buy credits (cap.canBuyCredits: self-serve, Owner/Admin)
      // \u2014 the same real gate the Plan section's Buy Credits button already uses, not a new capability.
      billingWidgetShowBuy: cap.canBuyCredits,
      billingWidgetPctLabel: Math.round(billConsumedPct) + '% of this month\u2019s credits',
      billingWidgetMeterTrackStyle: 'height:5px;border-radius:999px;background:rgba(97,72,249,0.14);overflow:hidden',
      billingWidgetMeterFillStyle: 'height:100%;border-radius:999px;background:#6148F9;width:' + Math.min(100, billConsumedPct) + '%',
      billingWidgetStyle: 'display:flex;align-items:center;gap:11px;padding:9px 11px;border:1px solid rgba(20,20,30,0.1);border-radius:11px;background:#fff;' + (billingAccessAllowed ? 'cursor:pointer' : 'cursor:default'),
      billingWidgetHoverStyle: billingAccessAllowed ? 'border-color:rgba(97,72,249,0.35)' : 'border-color:rgba(20,20,30,0.1)',
      // Both entry points land on the Billing home page: the widget is a shortcut specifically to the
      billingAccessAllowed: billingAccessAllowed,
      // Profile switcher (Step 2.5) — prototype-only control, sidebar footer. Account type and role are
      // identity; data state is a separate mock-data toggle, kept apart on purpose (see ticket).
      profileSwitcherOpen: S.profileSwitcherOpen,
      ...(() => { const av = this.renderAvatar('Alex Rivera', 'AR', 30, 11.5); return { profileAvatarHasPhoto: av.hasPhoto, profileAvatarNoPhoto: av.noPhoto, profileAvatarPhotoUrl: av.photoUrl, profileAvatarPhotoStyle: av.photoStyle, profileAvatarStyle: av.fallbackStyle, profileAvatarInitials: av.initials }; })(),
      onToggleProfileSwitcher: () => set({ profileSwitcherOpen: !S.profileSwitcherOpen }),
      onCloseProfileSwitcher: () => set({ profileSwitcherOpen: false }),
      // Fixed flyout, not anchored above the trigger — the trigger sits at the very bottom of a
      // full-height sidebar, so an absolute popover growing upward can be taller than the space above
      // it and get clipped by the viewport (or by the sidebar's own overflow:hidden). A fixed panel with
      // top+bottom margins always fits the viewport and scrolls its own content instead.
      profileSwitcherPanelStyle: shellNarrow
        ? 'position:fixed;left:8px;right:8px;top:16px;bottom:16px;z-index:91;background:#fff;border:1px solid rgba(0,0,29,0.12);border-radius:12px;box-shadow:0 14px 32px -8px rgba(16,16,20,0.28);padding:14px;overflow-y:auto'
        : 'position:fixed;left:264px;width:300px;top:16px;bottom:16px;z-index:91;background:#fff;border:1px solid rgba(0,0,29,0.12);border-radius:12px;box-shadow:0 14px 32px -8px rgba(16,16,20,0.28);padding:14px;overflow-y:auto',
      onToggleAccountType: () => set({ profileAccountType: billIsCustom ? 'self-serve' : 'custom' }),
      ...(() => {
        const orgAxis = S.peopleOrgAxis || 'organization';
        const filteredPersonas = this.PERSONAS.filter(p => p.account === orgAxis);
        const personaOrgOptions = ['organization', 'standalone'].map(a => ({
          id: a, label: a === 'organization' ? 'Organization' : 'Standalone',
          onClick: () => {
            const next = this.PERSONAS.filter(p => p.account === a);
            const stillValid = next.some(p => p.id === S.activePersonaId);
            set({ peopleOrgAxis: a, activePersonaId: stillValid ? S.activePersonaId : next[0].id });
          },
          style: billToggleBtnStyle(orgAxis === a),
        }));
        const personaOptions = filteredPersonas.map(p => ({
          id: p.id, label: p.label, onClick: () => set({ activePersonaId: p.id }), style: billToggleBtnStyle(S.activePersonaId === p.id),
        }));
        const activePersona = this.PERSONAS.find(p => p.id === S.activePersonaId) || filteredPersonas[0];
        const viewer = this.personaViewer(activePersona.id);
        const row = this.renderPersonRow(viewer);
        const openState = s => this.renderBadge('outlined', s, {}).pillStyle;
        return {
          personaOrgOptions, personaOptions,
          personaPanelStyle: this.renderPanelStyle(false),
          personaRow0Style: this.renderPanelRowStyle(0, false),
          personaRow1Style: this.renderPanelRowStyle(1, false),
          personaAvatarStyle: row.avatarStyle, personaInitials: row.initials, personaName: row.name,
          personaRoleLabel: activePersona.role, personaScopeLabel: activePersona.scope,
          personaHasWorkspaces: row.workspaceChips.length > 0, personaWorkspaceChips: row.workspaceChips,
          personaHasTeams: row.teamChips.length > 0, personaTeamChips: row.teamChips,
          personaCan: activePersona.roleCan,
          personaCannot: activePersona.roleCannot.map(c => ({ label: c.label, state: c.state, stateStyle: openState(c.state) })),
          personaHasOpenNote: !!activePersona.openNote,
          personaOpenNote: activePersona.openNote || '',
        };
      })(),
      profileRoleLabel: S.profileRole,
    };
  }

  chooseFile(source) {
    this.setState({ file: Object.assign({ source }, this.FILE), fileSource: source, name: this.state.name || 'Q3 Product Launch' });
  }
}
</script>
</body>
</html>
