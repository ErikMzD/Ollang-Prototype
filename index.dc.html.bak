      dtQualityIconWrap: 'width:26px;height:26px;border-radius:7px;background:#F1F1F4;color:#6B6B78;display:flex;align-items:center;justify-content:center;flex:none',
      dtGates: dtGates.map((g, i) => {
        const skipped = g.status === 'Skipped';
        const waiting = !!g.active;
        const passed = !skipped && !waiting;
        const ac = '#0E7CC4';
        const pc = '#1C8A5A';
        const col = skipped ? '#B0B0BA' : waiting ? ac : pc;
        return {
          name: g.name, detail: g.detail, status: g.status, isHuman: !skipped,
          wrapStyle: 'display:flex;align-items:flex-start;gap:11px;padding:13px 18px;'
            + (i > 0 ? 'border-top:1px solid rgba(0,0,29,0.07);' : '')
            + (skipped ? 'background:#FAFAFB' : passed ? 'background:rgba(28,138,90,0.03)' : 'background:rgba(14,124,196,0.03)'),
          nodeGlyph: passed
            ? React.createElement('svg', { width: 12, height: 12, viewBox: '0 0 24 24', fill: 'none', stroke: '#fff', strokeWidth: 2.8, strokeLinecap: 'round', strokeLinejoin: 'round' }, React.createElement('path', { d: 'M20 6L9 17l-5-5' }))
            : skipped ? '\u2013' : '',
          nodeStyle: 'width:20px;height:20px;border-radius:7px;flex:none;margin-top:2px;display:flex;align-items:center;justify-content:center;font:600 11px var(--font-ui);box-sizing:border-box;'
            + (skipped
              ? 'border:1.5px dashed rgba(0,0,29,0.18);background:#fff;color:#B0B0BA'
              : waiting
                ? 'background:' + ac + ';color:#fff;box-shadow:0 0 0 3px rgba(14,124,196,0.16)'
                : 'background:' + pc + ';color:#fff'),
          nameStyle: skipped
            ? 'font:500 13px var(--font-ui);color:#8A8A96'
