      headline: ['What do you want to translate?', 'Set up your captions', 'Name it and choose where it lives', 'Review and confirm', ''][S.step - 1],
      subhead: ['Choose a translation type, then add your file.', 'Pick languages and how the captions should look.', 'So you can find this translation again later.', 'Here\u2019s exactly what you\u2019re ordering and what it costs.', ''][S.step - 1],
      kindSelected: !!S.kind,
      hasFile: !!S.file, noFile: !S.file, file: S.file || this.FILE,
      onBrowse: () => this.chooseFile('Upload'),
      onRemoveFile: () => set({ file: false, fileSource: '' }),
      rev: this.toggle(S.reviewer),
      onToggleReviewer: () => set({ reviewer: !S.reviewer }),
      reviewer: S.reviewer,
      ...(() => {
        // Step 6: consumes Step 4's REVIEW_TEAMS and Steps 3/5's org/standalone axis \u2014 no new team
        // data model. "workspace access" side of the eligibility formula reuses WS_ROWS (same records
        // Workspace access/Step 3 reads); the wizard's own S.workspace is a free-text mock name (WORKSPACES
        // array) that doesn't 1:1 match WS_ROWS ids, so it's matched by name substring \u2014 a mock-data
        // seam, not a new concept. 'Marketing' matches WS_ROWS' 'Product Marketing' (w1) this way.
        const account = (this.PERSONAS.find(p => p.id === S.activePersonaId) || {}).account || 'organization';
        // Fix: access holders now come from PEOPLE_DIRECTORY.workspaces (same fix as Step 3's Workspace
        // access tab) instead of WS_ROWS, whose managers/contributors/viewers never overlapped
        // PEOPLE_DIRECTORY's roster at all. S.workspace (the wizard's own field) is compared directly
        // against PEOPLE_DIRECTORY's 3 canonical workspace names \u2014 no substring matching needed since
        // 'Marketing' is a literal option in both this wizard's WORKSPACES list and PEOPLE_DIRECTORY.
        const accessHolders = this.PEOPLE_DIRECTORY.filter(p => (p.workspaces || []).includes(S.workspace)).map(p => p.name);
        const team = this.REVIEW_TEAMS.find(t => t.id === S.reviewTeamSel);
        const eligible = !team ? [] : (account === 'standalone' ? (team.members || []) : (team.members || []).filter(n => accessHolders.includes(n)));
        const chipFor = name => {
          const person = this.PEOPLE_DIRECTORY.find(p => p.name === name) || this.PEOPLE.find(p => p.name === name) || {};
          const av = this.renderAvatar(name, person.initials, 22, 10);
          return { name, initials: av.initials, avatarHasPhoto: av.hasPhoto, avatarNoPhoto: av.noPhoto, avatarPhotoUrl: av.photoUrl, avatarPhotoStyle: av.photoStyle, avatarStyle: av.fallbackStyle };
        };
        return {
          reviewTeamOpen: S.reviewTeamOpen, onToggleReviewTeam: () => set({ reviewTeamOpen: !S.reviewTeamOpen }),
          reviewTeamLabel: team ? team.name : 'Choose a Review Team',
          reviewTeamColor: team ? '#16161A' : '#8A8A96',
          reviewTeamOptions: this.REVIEW_TEAMS.map(t => ({ name: t.name, desc: t.desc, onClick: () => set({ reviewTeamSel: t.id, reviewTeamOpen: false }) })),
          hasSelectedTeam: !!team,
          eligibleChips: eligible.map(chipFor), eligibleIsEmpty: !!team && eligible.length === 0,
          eligibleFormulaLabel: account === 'standalone'
