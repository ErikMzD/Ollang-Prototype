      pairSaveOpen: S.pairSaveOpen,
      pairPopoverSummary: 'Saves ' + (S.sourceLang === 'auto' ? 'Auto-detect' : this.langName(S.sourceLang)) + ' plus ' + langCount + ' destination language' + (langCount === 1 ? '' : 's') + ' together.',
      onTogglePairSave: () => set({ pairSaveOpen: !S.pairSaveOpen, pairName: '', pairMenuFor: 0 }),
