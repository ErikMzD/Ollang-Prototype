            : 'font:400 12px var(--font-ui);color:#5B5B66;margin-top:2px',
          statusStyle: 'flex:none;align-self:center;'
            + (skipped
              ? 'font:500 11px var(--font-ui);color:#6B6B78'
              : waiting
                ? 'display:inline-flex;align-items:center;padding:3px 9px;border-radius:6px;font:600 11px var(--font-ui);color:#fff;background:' + ac
