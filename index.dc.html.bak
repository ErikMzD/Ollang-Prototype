    { action: 'Delivered', entity: 'Product_Launch_Deck.pdf', statVal: 'Jul 24, 2026 · 2:14 PM', pillLabel: 'Delivered', pillActive: true, progressPct: 100, iconId: 'check', nextIconId: null, note: 'Ready to review and download' },
  ];

  // Generates the older, already-`paid` invoices behind a hand-authored current one (C2: production has 13
  // invoices, paginated 10/page — enough rows to make pagination real, not 3-4). Deterministic, monthly.
  MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  // Real 13-row invoice history, shared across both account types (only payability differs by account —
  // see billInvoiceRow). Mostly paid/$0.00 like production, with the few real amounts production shows
  // ($2.20, $1,000.00) and one VAT case (net 200 -> total 250 @ 25%) so Net Total and Total (VAT) can
  // actually diverge. `readyToPay` appears early so the payable-row treatment is visible on page 1.
  BILL_INVOICE_HISTORY = [
    { status: 'paid', amount: 0 },
    { status: 'paid', amount: 0 },
    { status: 'readyToPay', amount: 2.20 },
    { status: 'paid', amount: 0 },
    { status: 'overdue', amount: 1000 },
    { status: 'paid', amount: 0 },
    { status: 'paid', amount: 200, vatRate: 25 },
    { status: 'paid', amount: 0 },
    { status: 'notReady', amount: 0 },
    { status: 'paid', amount: 0 },
    { status: 'paid', amount: 0 },
    { status: 'paid', amount: 0 },
  ];
  // Deterministic time-of-day per bill (hash of id) so Due Date can show date AND time, matching production.
  billInvoiceTime(id) {
    const h = id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    return { hh: h % 24, mm: (h * 7) % 60 };
  }
  // Single date+time formatter — Due Date and each line item's Created At both go through this, so a
  // format change never has to be made in two places.
  formatDateTime(year, month, day, hh, mm) {
    return String(month + 1).padStart(2, '0') + '/' + String(day).padStart(2, '0') + '/' + year + ' - ' + String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0');
  }
  // The unit set is open (min/words today, more later, ‘other’ currently displays as ‘min’ in
  // production and this preserves that quirk rather than “fixing” it). A lookup + fallback, never a
  // switch keyed to a fixed list — a future unit just needs an entry here, nothing else changes.
  BILL_UNIT_LABELS = { min: 'min', words: 'words', other: 'min' };
  formatUnitCount(qty, unit) {
    return qty + ' ' + (this.BILL_UNIT_LABELS[unit] || unit);
  }
  // Shared table shell (header + rows): the invoice list, the invoice line-item table, and any future
  // grid table all size their columns from the same function. Row-DATA mapping still differs per context
  // (the columns themselves differ), so this is the table, not a fourth row-renderer.
  renderTableGrid(cols) {
    return 'display:grid;grid-template-columns:' + cols.join(' ') + ';gap:16px;align-items:center;padding:12px 0';
  }
  // Line items carry their OWN status, independent of the invoice's (the invoice's status is plausibly
  // derived from these in the real product; this mock does not model that derivation, and deliberately
  // does not force line statuses to agree with the invoice's, since it isn't true they always do).
  BILL_LINE_SERVICES = [
    { service: 'AI Dubbing', code: 'db', unit: 'min', iconId: 'ai_dubbing' },
    { service: 'Subtitle Translation', code: 'st', unit: 'min', iconId: 'subtitle' },
    { service: 'Document Translation', code: 'dt', unit: 'words', iconId: 'document' },
    { service: 'Video Captioning', code: 'cc', unit: 'min', iconId: 'video_captioning' },
    { service: 'Audio Description', code: 'ad', unit: 'other', iconId: 'audio_description' },
  ];
  // Coherence floor (pass 3 correction): a line's status can't contradict its invoice's. Paid invoices
  // can only have paid lines; ready-to-pay/overdue invoices can't have any paid line (nothing's been paid
  // yet); notReady/Preparing Invoice invoices are the only ones that are genuinely mixed — deliberately so,
  // since a uniform status there would give the Status Filter nothing to prove.
  BILL_LINE_STATUS_CYCLES = {
    paid: ['paid'],
    readyToPay: ['notReady', 'resuming', 'readyToPay', 'overdue'],
    overdue: ['notReady', 'resuming', 'readyToPay', 'overdue'],
    notReady: ['paid', 'notReady', 'resuming', 'readyToPay', 'overdue'],
    resuming: ['paid', 'notReady', 'resuming', 'readyToPay', 'overdue'],
  };
  billInvoiceLineItems(inv) {
    const seedBase = inv.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    const tgtCodes = ['es', 'fr', 'de', 'ja', 'pt'];
    const statusCycle = this.BILL_LINE_STATUS_CYCLES[inv.status] || ['paid'];
    return Array.from({ length: 9 }, (_, i) => {
      const svc = this.BILL_LINE_SERVICES[i % this.BILL_LINE_SERVICES.length];
      const seed = seedBase + i * 37;
      const src = 'en', tgt = svc.code === 'cc' ? 'en' : tgtCodes[seed % tgtCodes.length];
      const qty = +(((seed % 480) / 100) + 0.05).toFixed(2);
      const hh = (seed * 3) % 24, mm = (seed * 11) % 60, day = 1 + (seed % 27), month = seed % 12;
      const ext = (this.FILE_EXT[svc.service] || 'WAV').toLowerCase();
      return {
        file: 'ollang_' + (800 + (seed % 200)) + '_' + (1785800000000 + seed * 9973) + '_audio.' + ext,
        serviceCode: svc.code, iconId: svc.iconId, src, tgt, unit: svc.unit, qty,
        createdAt: this.formatDateTime(2026, month, day, hh, mm),
        amount: 0,
        status: statusCycle[i % statusCycle.length],
      };
    });
  }

  billInvoiceFinancials(row, month, day, year) {
    const vatRate = row.vatRate || 0;
    const netTotal = row.amount;
    const total = vatRate ? +(netTotal * (1 + vatRate / 100)).toFixed(2) : netTotal;
    const { hh, mm } = this.billInvoiceTime(row.id);
    const dueMs = new Date(year, month, day, hh, mm).getTime();
    const dueLabel = this.formatDateTime(year, month, day, hh, mm);
    return Object.assign({}, row, { vatRate, netTotal, amount: total, dueMs, dueLabel });
  }
  genInvoices(current, baseAmount, count) {
    const [mName, dRaw, yRaw] = current.due.split(' ');
    let month = this.MONTH_NAMES.indexOf(mName), day = parseInt(dRaw.replace(',', ''), 10), year = parseInt(yRaw, 10);
    let idNum = parseInt(current.id.split('-')[1], 10);
    const prefix = current.id.split('-')[0];
    const out = [this.billInvoiceFinancials(current, month, day, year)];
    for (let i = 1; i < count; i++) {
      month -= 1; if (month < 0) { month = 11; year -= 1; }
      idNum -= 1;
      const h = this.BILL_INVOICE_HISTORY[(i - 1) % this.BILL_INVOICE_HISTORY.length];
      const id = prefix + '-' + idNum;
      const due = this.MONTH_NAMES[month] + ' ' + day + ', ' + year;
      out.push(this.billInvoiceFinancials({ id, status: h.status, amount: h.amount, vatRate: h.vatRate, due }, month, day, year));
    }
    return out;
  }

  // MOCK DATA — Billing (A6/C5/C6): two account types, each a fully self-contained model (plan, allowance,
  // credit balance + dated lots that sum to it, invoices, consumption). healthy and trouble are the SAME
  // account at two points in time — trouble's balance/lots equal healthy's minus the extra credits consumed
  // since (lots draw down FIFO, nearest-expiry first). accountType is chosen via the profile switcher.
  // custom: healthy 60000+12061009.01=12121009.01; trouble 14000+11044509.01=11058509.01, a decrease of
  // exactly 1,062,500 (2,412,500-1,350,000). self-serve: healthy 6400+26000=32400; trouble 1200+17200=18400,
  // a decrease of exactly 14,000 (52,000-38,000). Each state's usageRows (Ollang, automated) + hitlRows
  // (human review, C6 — its own unit shape: language pair + its own expiry, not a generic "credits" row)
  // sum to exactly that state's cycleConsumed. Lots carry the full production model (C6): assigned vs.
  // remaining, load/expiry dates, and a status — 'active' | 'expired' | 'transferred' — with at least one
  // transferred-to-pool lot per account, matching A5's fields, not just a number and a date.
  BILLING_BY_ACCOUNT = {
    'self-serve': {
      // Real plan (C4) — Developer, $20/mo ($18/mo billed yearly), 100,000 credits/month. Not "Growth".
      planName: 'Developer', planAllowance: 100000, planPriceMonthly: 20, nextBillingDate: 'Aug 15, 2026',
      states: {
        healthy: {
          balance: 32400, cycleConsumed: 38000,
          lots: [
            { assigned: 10000, remaining: 6400, loadedAt: 'Jul 20, 2026', expires: 'Aug 18, 2026', status: 'active' },
            { assigned: 26000, remaining: 26000, loadedAt: 'Jul 1, 2026', expires: 'Nov 1, 2026', status: 'active' },
            { assigned: 8000, remaining: 0, loadedAt: 'Jun 1, 2026', expires: 'Jul 1, 2026', status: 'transferred' },
          ],
          spendLimitSet: false, spendLimitAmount: null, spendLimitReached: false, spendLimitResets: 'Aug 31, 2026',
          spendLimitSpent: 0, notificationThresholds: [],
          defaultCard: 'Visa •••• 4242',
          cards: [
            { id: 'c1', name: 'My Business Card', brand: 'VISA', last4: '4242', isDefault: true },
            { id: 'c2', name: 'Backup Card', brand: 'MASTERCARD', last4: '8831', isDefault: false },
          ],
          invoices: null,
        },
        trouble: {
          balance: 18400, cycleConsumed: 52000,
          lots: [
            { assigned: 10000, remaining: 1200, loadedAt: 'Jul 20, 2026', expires: 'Aug 9, 2026', status: 'active' },
            { assigned: 26000, remaining: 17200, loadedAt: 'Jul 1, 2026', expires: 'Nov 1, 2026', status: 'active' },
            { assigned: 8000, remaining: 0, loadedAt: 'May 1, 2026', expires: 'Jun 1, 2026', status: 'expired' },
          ],
          spendLimitSet: true, spendLimitAmount: 50, spendLimitReached: true, spendLimitResets: 'Aug 31, 2026',
          spendLimitSpent: 50, notificationThresholds: [23],
          defaultCard: null,
          cards: [],
          invoices: null,
        },
      },
    },
    custom: {
      planName: 'Custom Enterprise', planAllowance: 2500000, planPriceMonthly: null, nextBillingDate: 'Aug 10, 2026',
      aiDubbingEditDays: 45, maxFileSizeMB: 500,
      states: {
        healthy: {
          balance: 12121009.01, cycleConsumed: 1350000,
          lots: [
            { assigned: 75000, remaining: 60000, loadedAt: 'Jul 1, 2026', expires: 'Aug 20, 2026', status: 'active' },
            { assigned: 12061009.01, remaining: 12061009.01, loadedAt: 'Jan 1, 2026', expires: 'Dec 1, 2026', status: 'active' },
            { assigned: 50000, remaining: 0, loadedAt: 'Jun 1, 2026', expires: 'Jul 1, 2026', status: 'transferred' },
          ],
          invoices: null,
        },
        trouble: {
          balance: 11058509.01, cycleConsumed: 2412500,
          lots: [
            { assigned: 75000, remaining: 14000, loadedAt: 'Jul 1, 2026', expires: 'Aug 9, 2026', status: 'active' },
            { assigned: 11044509.01, remaining: 11044509.01, loadedAt: 'Jan 1, 2026', expires: 'Dec 1, 2026', status: 'active' },
            { assigned: 50000, remaining: 0, loadedAt: 'May 1, 2026', expires: 'Jun 1, 2026', status: 'expired' },
          ],
          invoices: null,
        },
      },
    },
  };

  // Invoices, usageRows and hitlRows are assembled here (rather than as static literals above) so
  // genInvoices — a class method — can generate the 13-row paginated history behind each hand-authored
  // current invoice.
  billStateData(accountType, demoKey) {
    const acct = this.BILLING_BY_ACCOUNT[accountType];
    const st = acct.states[demoKey];
    if (st._built) return st;
    const packs = {
      'self-serve|healthy': {
        invoices: this.genInvoices({ id: 'INV-3301', status: 'notReady', amount: 20, due: 'Aug 15, 2026', lines: [
          { service: 'AI Dubbing', provider: 'ElevenLabs', iconId: 'ai_dubbing', amount: 12, units: [{ unit: 'min', qty: 40, label: 'minutes' }] },
          { service: 'Document Translation', provider: 'DeepL', iconId: 'document', amount: 6, units: [{ unit: 'words', qty: 4000, label: 'words' }] },
          { service: 'Linguist review', provider: 'Ollang review network', iconId: 'people', hitl: true, amount: 2, units: [{ unit: 'reviews', qty: 2, label: 'reviews' }] },
        ] }, 20, 13),
        aiConsumption: {
          aiDubbing: { whisper: 3200, deepl: 4800, elevenlabs: 8000 },
          documentTranslation: { deepl: 7200, gpt4o: 4800 },
        },
        hitlRows: [{ languagePair: 'English \u2192 Spanish', provider: 'Ollang review network', credits: 10000, expires: 'Sep 15, 2026', workflowChain: 'Subtitle \u2013 Closed Captioning', unit: 'reviews', previousStepsIncluded: true }],
      },
      'self-serve|trouble': {
        invoices: this.genInvoices({ id: 'INV-3298', status: 'overdue', amount: 20, due: 'Jul 20, 2026', lines: [
          { service: 'AI Dubbing', provider: 'ElevenLabs', iconId: 'ai_dubbing', amount: 13, units: [{ unit: 'min', qty: 43, label: 'minutes' }] },
          { service: 'Document Translation', provider: 'DeepL', iconId: 'document', amount: 5, units: [{ unit: 'words', qty: 3333, label: 'words' }] },
          { service: 'Linguist review', provider: 'Ollang review network', iconId: 'people', hitl: true, amount: 2, units: [{ unit: 'reviews', qty: 2, label: 'reviews' }] },
        ] }, 20, 13),
        aiConsumption: {
          aiDubbing: { whisper: 4400, deepl: 6600, elevenlabs: 11000 },
          documentTranslation: { deepl: 10800, gpt4o: 7200 },
        },
        // \u00a76/\u00a710: deliberately empty \u2014 this is the one mock combination that demonstrates the
        // HITL Credits tab being genuinely absent (not every account/state should show it).
        hitlRows: [],
      },
      'custom|healthy': {
        invoices: this.genInvoices({ id: 'INV-1042', status: 'notReady', amount: 8420, due: 'Aug 10, 2026', lines: [
          { service: 'AI Dubbing', provider: 'ElevenLabs', iconId: 'ai_dubbing', amount: 4210, units: [{ unit: 'min', qty: 41333, label: 'minutes' }] },
          { service: 'Subtitle Translation', provider: 'DeepL', iconId: 'subtitle', amount: 2530, units: [{ unit: 'min', qty: 13316, label: 'minutes' }] },
          { service: 'Linguist review', provider: 'Ollang review network', iconId: 'people', hitl: true, amount: 1680, units: [{ unit: 'reviews', qty: 400, label: 'reviews' }] },
        ] }, 8420, 13),
        aiConsumption: {
          aiDubbing: { whisper: 124000, deepl: 186000, elevenlabs: 310000 },
          subtitleTranslation: { whisper: 123000, deepl: 287000 },
          videoCaptioning: { whisper: 143000, azure_speech: 77000 },
        },
        hitlRows: [{ languagePair: 'English \u2192 Spanish', provider: 'Ollang review network', credits: 100000, expires: 'Sep 15, 2026', workflowChain: 'AI Dubbing \u2013 Human QA Pass', unit: 'minutes reviewed', previousStepsIncluded: true }],
      },
      'custom|trouble': {
        invoices: this.genInvoices({ id: 'INV-1038', status: 'overdue', amount: 6120, due: 'Jul 24, 2026', lines: [
          { service: 'AI Dubbing', provider: 'ElevenLabs', iconId: 'ai_dubbing', amount: 3000, units: [{ unit: 'min', qty: 28000, label: 'minutes' }] },
          { service: 'Video Captioning', provider: 'Whisper', iconId: 'video_captioning', amount: 1800, units: [{ unit: 'min', qty: 15000, label: 'minutes' }] },
          { service: 'Linguist review', provider: 'Ollang review network', iconId: 'people', hitl: true, amount: 1320, units: [{ unit: 'reviews', qty: 268, label: 'reviews' }] },
        ] }, 8420, 13),
        aiConsumption: {
          aiDubbing: { whisper: 210000, deepl: 315000, elevenlabs: 525000 },
          subtitleTranslation: { whisper: 234000, deepl: 546000 },
          videoCaptioning: { whisper: 221000, azure_speech: 119000 },
        },
        hitlRows: [
          { languagePair: 'English \u2192 Spanish', provider: 'Ollang review network', credits: 150000, expires: 'Sep 1, 2026', workflowChain: 'AI Dubbing \u2013 Human QA Pass', unit: 'minutes reviewed', previousStepsIncluded: true },
          { languagePair: 'English \u2192 German', provider: 'Ollang review network', credits: 92500, expires: 'Sep 10, 2026', workflowChain: 'Subtitle \u2013 Closed Captioning', unit: 'reviews', previousStepsIncluded: false },
        ],
      },
    };
    const pack = packs[accountType + '|' + demoKey];
    st.invoices = pack.invoices; st.aiConsumption = pack.aiConsumption; st.hitlRows = pack.hitlRows;
    st._built = true;
    return st;
  }

  // Fallback line-item generator for invoices that don't carry hand-authored `lines` (the older, already-
  // paid ones in the list) — so drilling into ANY invoice always resolves. Deterministic per id, not random,
  // so the same invoice always shows the same synthesized line on repeat visits.
  BILL_SERVICES = [
    { service: 'AI Dubbing', provider: 'ElevenLabs', iconId: 'ai_dubbing', unit: 'min', label: 'minutes', rate: 0.46 },
    // Fixed data error (C6 usage rewrite): Subtitle Translation is billed per minute, not per word —
    // Document Translation is the only per-word service in the rate table.
    { service: 'Subtitle Translation', provider: 'DeepL', iconId: 'subtitle', unit: 'min', label: 'minutes', rate: 0.19 },
    { service: 'Document Translation', provider: 'DeepL', iconId: 'document', unit: 'words', label: 'words', rate: 0.0015 },
    { service: 'Video Captioning', provider: 'Whisper', iconId: 'video_captioning', unit: 'min', label: 'minutes', rate: 0.12 },
  ];
  billInvoiceLines(inv) {
    if (inv.lines) return inv.lines;
    const h = inv.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
    const svc = this.BILL_SERVICES[h % this.BILL_SERVICES.length];
    return [{ service: svc.service, provider: svc.provider, iconId: svc.iconId, amount: inv.amount, units: [{ unit: svc.unit, qty: Math.round(inv.amount / svc.rate), label: svc.label }] }];
  }

  // AI consumption hierarchy (C6 usage rewrite). Two taxonomies, kept distinct:
