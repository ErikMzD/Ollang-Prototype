  // MOCK DATA — one translation job told as 3 progress states, cycled by the Translations empty-state carousel; not real data.
  LS_EMPTY_STORY = [
    { action: 'Uploading your file', entity: 'Product_Launch_Deck.pdf', statVal: '1 of 1 files', pillLabel: 'Uploading', pillActive: false, progressPct: 20, iconId: 'upload', nextIconId: 'website', note: 'Files, text, or a connected site' },
