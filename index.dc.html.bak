      helpSubType: e => this.openHelp('subtype', e), helpInVideoText: e => this.openHelp('invideotext', e), helpLipSync: e => this.openHelp('lipsync', e),
      isStep1: S.step === 1, isStep2: S.step === 2, isStep3: S.step === 3, isStep4: S.step === 4, isStep5: S.step === 5,
      wizContentWidthStyle: 'width:100%;max-width:' + (S.step === 1 ? '1180px' : '640px'),
      showTitle: S.step !== 5,
