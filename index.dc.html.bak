            : (team ? team.name + ' members with access to ' + (S.workspace || 'this workspace') + '.' : ''),
          eligibleEmptyLabel: 'No one on ' + (team ? team.name : 'this team') + ' currently has access to ' + (S.workspace || 'this workspace') + '.',
        };
      })(),
