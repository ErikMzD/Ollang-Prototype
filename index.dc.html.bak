        };
      }),
      dtVcCaptionLineShow: done, // Video Captioning-only: the caption sample overlay on the delivered video frame
      dtVcCaptionSample: 'This is how the delivered captions look.',
      dtQualityFacts: [
        {
          label: 'Revisions', value: done ? '1 requested, resolved before delivery' : 'None requested yet',
          icon: React.createElement('svg', { width: 14, height: 14, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.8, strokeLinecap: 'round', strokeLinejoin: 'round' },
            React.createElement('path', { d: 'M3 12a9 9 0 1 0 3-6.7' }), React.createElement('path', { d: 'M3 4v5h5' })),
        },
        {
          label: 'Quality scores', value: 'Not recorded for this translation',
          icon: React.createElement('svg', { width: 14, height: 14, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.8, strokeLinecap: 'round', strokeLinejoin: 'round' },
            React.createElement('path', { d: 'M4 19V10M12 19V5M20 19v-6' })),
        },
        {
          label: 'QC annotations', value: done ? 'None flagged by the reviewer' : 'Pending review',
          icon: React.createElement('svg', { width: 14, height: 14, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.8, strokeLinecap: 'round', strokeLinejoin: 'round' },
            React.createElement('path', { d: 'M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z' }), React.createElement('path', { d: 'M12 8v5' }), React.createElement('circle', { cx: 12, cy: 15.5, r: 0.3, fill: 'currentColor' })),
        },
      ].map((q, i) => ({
        label: q.label, value: q.value, icon: q.icon,
        rowStyle: 'display:flex;align-items:center;gap:11px;padding:12px 18px;' + (i > 0 ? 'border-top:1px solid rgba(0,0,29,0.07)' : ''),
      })),
      dtRevisionSummary: done ? '1 revision requested and resolved before delivery.' : 'No revisions requested yet.',
      dtWorkflowName: row.workflow,
      dtWorkflowSource: 'Applied from the ' + (row.workspace || row.project) + ' workspace workflow',
      dtGatesEmpty: dtGates.length === 0,
      dtTraceStepCount: dtTrace.length + ' steps',
      dtTrace: dtTrace.map((n, i) => {
        const open = !!S.traceOpen[n.id];
        const isDone = n.status === 'Done' || n.status === 'Passed';
        const isWait = n.status === 'Waiting for reviewer' || n.status === 'In progress';
        const isFailed = n.status === 'Failed';
        const col = isFailed ? '#C42B31' : (n.human ? '#0B6BAB' : '#6148F9');
        const shape = n.human ? '8px' : '50%';
        return {
          title: n.title, sub: n.sub, status: n.status, open, connector: i < dtTrace.length - 1,
          mark: isDone
            ? React.createElement('svg', { width: 13, height: 13, viewBox: '0 0 24 24', fill: 'none', stroke: '#fff', strokeWidth: 2.6, strokeLinecap: 'round', strokeLinejoin: 'round' }, React.createElement('path', { d: 'M20 6L9 17l-5-5' }))
            : isFailed
              ? React.createElement('svg', { width: 13, height: 13, viewBox: '0 0 24 24', fill: 'none', stroke: '#fff', strokeWidth: 2.6, strokeLinecap: 'round' }, React.createElement('path', { d: 'M12 8v5' }), React.createElement('circle', { cx: 12, cy: 16.3, r: 0.3, fill: '#fff' }))
              : String(n.num || ''),
          kindLabel: n.human ? 'Human' : 'Automated',
          kindPill: 'font:600 9.5px var(--font-ui);letter-spacing:.06em;text-transform:uppercase;color:' + (n.human ? '#0B6BAB' : '#4F39D8'),
          statusPill: isDone
            ? 'display:inline-flex;align-items:center;padding:5px 12px;border-radius:999px;font:600 11px var(--font-ui);color:' + this.LS_STATUS_STYLE['Delivered'].c + ';background:' + this.LS_STATUS_STYLE['Delivered'].bg
            : (isWait || isFailed)
              ? 'display:inline-flex;align-items:center;padding:5px 12px;border-radius:999px;font:600 11.5px var(--font-ui);color:#fff;background:' + col
              : 'display:inline-flex;align-items:center;padding:5px 12px;border-radius:999px;font:500 11px var(--font-ui);color:#8A8A96;background:#F1F1F4',
          dotStyle: 'width:26px;height:26px;border-radius:' + shape + ';flex:none;display:flex;align-items:center;justify-content:center;font:600 11px var(--font-ui);color:#fff;box-sizing:border-box;'
            + (isDone || isFailed
              ? 'background:' + col
              : isWait
                ? 'background:' + col + ';box-shadow:0 0 0 4px ' + (n.human ? 'rgba(14,124,196,0.16)' : 'rgba(97,72,249,0.16)')
                : 'background:#fff;color:#B0B0BA;border:2px solid #E1E1E8'),
          rowStyle: 'display:flex;gap:14px;padding:14px 20px;box-sizing:border-box;background:#fff;'
            + (i > 0 ? 'border-top:1px solid rgba(0,0,29,0.07);' : ''),
          lineStyle: 'width:1.5px;flex:1;margin:4px 0 -14px;background:rgba(0,0,29,0.14)',
          chevStyle: 'width:26px;height:26px;border-radius:8px;flex:none;display:flex;align-items:center;justify-content:center;color:#8A8A96;transition:.14s;transform:rotate(' + (open ? '180deg' : '0') + ');border:none;background:transparent;cursor:pointer',
          railStyle: 'position:absolute;left:0;top:2px;bottom:18px;width:3px;border-radius:2px;background:' + (isDone || isWait || isFailed ? col : 'rgba(20,20,30,0.1)'),
          onToggle: () => this.setState(prev => {
            const t = Object.assign({}, prev.traceOpen);
            t[n.id] = !t[n.id];
            return { traceOpen: t };
          }),
          detailLine: (n.chips || []).concat((n.rows || []).map(rw => rw.label + ' ' + rw.value)).join('  ·  '),
