  WS_EMPTY_STORY = [
    { action: 'Naming your workspace', entity: 'Product Marketing', statVal: '1 of 3 fields', pillLabel: 'Draft', pillActive: false, progressPct: 20, iconId: 'folder', nextIconId: 'people', note: 'Helps your team find it fast' },
    { action: 'Adding your team', entity: 'Owner: Jamie Chen', rowKind: 'avatars', avatarsLabel: '+2 managers', avatars: [{ initials: 'JC', bg: '#2F80ED' }, { initials: 'PN', bg: '#B9459A' }, { initials: 'SO', bg: '#1C8A5A' }], pillLabel: 'Setting up', pillActive: false, progressPct: 60, iconId: 'people', nextIconId: 'check', note: 'Managers can invite and control access' },
