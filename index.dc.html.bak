        icon: React.createElement('svg', { width: 15, height: 15, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', strokeWidth: 1.9, strokeLinecap: 'round', strokeLinejoin: 'round' }, React.createElement('path', { d: a.d })),
        style: 'display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 15px;border-radius:10px;font:600 13px var(--font-ui);cursor:pointer;transition:.14s;'
          + (a.primary
