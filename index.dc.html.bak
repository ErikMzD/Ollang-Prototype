            : 'border:1px solid rgba(20,20,30,0.12);background:#fff;color:#16161A'),
      })),
      dtHasHeaderActions: dtActions.filter(a => a.header).length > 0,
      dtHasFiles: done, dtNoFiles: !done,
      dtFilesNote: done ? row.dests.length + ' file' + (row.dests.length === 1 ? '' : 's') : 'Files will appear when the translation finishes',
      dtFiles: done ? row.dests.map((code, fi) => ({
