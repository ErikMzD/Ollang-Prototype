          cur: st.cur,
          stageLabel: 'Stage ' + (si + 1) + ' of ' + arr.length,
          wrapStyle: 'flex:1;min-width:180px;padding:16px;border-radius:14px;cursor:pointer;transition:.14s;'
            + (st.cur ? 'background:#6148F9;border:1px solid #6148F9' : 'background:#fff;border:1px solid rgba(20,20,30,0.1)'),
